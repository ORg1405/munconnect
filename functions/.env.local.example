# Copie para functions/.env.local (gitignored) para rodar no Emulator Suite.
# Parâmetros NÃO secretos das functions. Em produção vale o default do código
# (ENFORCE_APP_CHECK=true).
ENFORCE_APP_CHECK=false

# O segredo GEMINI_API_KEY NÃO vai aqui: no emulador ele vem de
# functions/.secret.local (gitignored), uma linha:
#   GEMINI_API_KEY=sua-chave
# Em produção: firebase functions:secrets:set GEMINI_API_KEY
